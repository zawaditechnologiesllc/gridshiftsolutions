# ─── Frontend (Next.js on Vercel) ────────────────────────────────────────────
# Copy to .env.local for local development. All NEXT_PUBLIC_* vars are exposed
# to the browser — never put secret keys here.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Render-hosted payments API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://gridshift-api.onrender.com

# Display currency for prices (must match PAYSTACK_CURRENCY on the backend)
NEXT_PUBLIC_CURRENCY=USD

# Public site URL (used for SEO metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Support contact shown on the Support page
NEXT_PUBLIC_SUPPORT_EMAIL=support@gridshiftsolutions.com
NEXT_PUBLIC_SUPPORT_HOURS=Mon–Fri, 8:00–18:00

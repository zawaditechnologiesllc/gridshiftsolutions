# ─── Backend (Express payments API on Render) ────────────────────────────────
# Copy to server/.env for local development. These are SECRET — never commit
# real values and never expose them to the browser.

# Port (Render sets this automatically in production)
PORT=4000

# Public URL of the deployed frontend (used for CORS + Paystack callback)
FRONTEND_URL=http://localhost:3000

# Supabase — use the SERVICE ROLE key (Settings → API). Bypasses RLS.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Paystack (Dashboard → Settings → API Keys & Webhooks).
# Paste your real key here — test keys start with "sk_test_", live keys "sk_live_".
PAYSTACK_SECRET_KEY=REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY

# Paystack settlement currency — must be enabled on your Paystack account
# (USD, NGN, GHS, KES, ZAR, ...). Amounts are charged in the subunit (cents).
PAYSTACK_CURRENCY=USD

# CJdropshipping API 2.0 (CJ Dashboard → Authorization → API Key).
# Powers admin product import. The email is your CJ login; the API key is the
# generated key (NOT your password).
CJ_EMAIL=you@example.com
CJ_API_KEY=your-cjdropshipping-api-key
# Retail markup applied to CJ cost on import (admin can override per product).
CJ_DEFAULT_MARKUP=2.4
